# Copy to deploy/.env on the server (git-ignored) and `chmod 600 deploy/.env`.

# Image tag: the commit sha the image was built from (docs/deploy.md)
TAG=
# Port on 127.0.0.1 the server's proxy points at
API_PORT=8080

# Goes raw into DATABASE_URL: keep it URL-safe. Generate with `openssl rand -hex 32`
POSTGRES_PASSWORD=

# Gemini (parameter suggestions and the A9 narratives); empty = deterministic text only
GEMINI_API_KEY=
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest

# Session cookie without Secure: set to false ONLY while the site has no HTTPS (browsers drop it over http)
# COOKIE_SECURE=true

# Failed login attempts per IP per 15 min (default 20)
# LOGIN_RATE_LIMIT=20
