# Postgres (docker-compose.yml usa user/senha/banco "app" fixos em dev; esta URL e o default de api/db.py)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Banco dos testes (pytest cria se faltar e nunca usa o DATABASE_URL de dev)
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test

# Diretorio do build do SPA servido pela API (default: web/dist)
# WEB_DIST=web/dist

# Cloud Run injeta PORT; local o uvicorn sobe em 8000 pelo mise
# PORT=8080

# Diretorio dos arquivos enviados (storage local; GCS entra no B11). Default: data
# STORAGE_DIR=data

# Chave do Gemini para as sugestões de parâmetros (sem ela, só as sugestões dos dados). Secret Manager no B11
# GEMINI_API_KEY=

# engine.run falso até o A0: pausa entre as etapas do log (s) e falha forçada (1) para ver o caminho de erro
# FAKE_ENGINE_STEP_SECONDS=1
# FAKE_ENGINE_FAIL=

# Conector Google (B8): o BigQuery usa ADC. Local: `gcloud auth application-default login` ou o JSON de uma service account
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/sa.json
# Projeto que paga as queries (sem ele, o do ADC)
# GOOGLE_CLOUD_PROJECT=
# Só para tests/api/test_bigquery_live.py, contra um BigQuery sandbox
# BIGQUERY_TEST_PROJECT=
