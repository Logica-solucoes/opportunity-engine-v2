# Postgres (docker-compose.yml usa user/senha/banco "app" fixos em dev; esta URL e o default de api/db.py)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Banco dos testes (pytest cria se faltar e nunca usa o DATABASE_URL de dev)
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test

# Diretorio do build do SPA servido pela API (default: web/dist)
# WEB_DIST=web/dist

# Cloud Run injeta PORT; local o uvicorn sobe em 8000 pelo mise
# PORT=8080

# Diretorio dos arquivos enviados (storage local; GCS entra no B11). Default: data
# STORAGE_DIR=data
