# Postgres (docker-compose.yml usa user/senha/banco "app" fixos em dev; esta URL e o default de api/db.py)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Banco dos testes (pytest cria se faltar e nunca usa o DATABASE_URL de dev)
# TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app_test

# Diretorio do build do SPA servido pela API (default: web/dist)
# WEB_DIST=web/dist

# Porta da imagem (default 8080); local o uvicorn sobe em 8000 pelo mise
# PORT=8080

# Diretorio dos arquivos enviados (disco local, também em produção: volume com backup). Default: data
# STORAGE_DIR=data

# Chave do Gemini para as sugestões de parâmetros (sem ela, só as sugestões dos dados). Em produção, no .env do servidor
# GEMINI_API_KEY=

# Provedor e modelo de LLM do motor (módulo llm/). Provedores: gemini | none (desliga e usa o texto determinístico).
# O launcher força none no worker até o A9 (api/launcher.py)
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest

# engine.run falso até o swap do motor real: pausa entre as etapas do log (s) e falha forçada (1) para ver o caminho de erro
# FAKE_ENGINE_STEP_SECONDS=1
# FAKE_ENGINE_FAIL=

# Conector Google (B8, fora do escopo por ora): o BigQuery usa ADC. Local: `gcloud auth application-default login` ou o JSON de uma service account
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/sa.json
# Projeto que paga as queries (sem ele, o do ADC)
# GOOGLE_CLOUD_PROJECT=
# Só para tests/api/test_bigquery_live.py, contra um BigQuery sandbox
# BIGQUERY_TEST_PROJECT=
